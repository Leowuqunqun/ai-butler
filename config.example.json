{
  "workspace": "/绝对/路径/给 agent 干活的工作目录",
  "allowFrom": [],
  "bindFirstSender": true,
  "maxReplyChars": 1200,
  "agentTimeoutMs": 300000,
  "typing": true,
  "quoteReply": true,
  "queueAck": true,
  "progressIntervalMs": 40000,
  "agent": {
    "backend": "echo",
    "dsh": {
      "bin": "dsh",
      "profile": "headless",
      "patchFile": "./examples/dsh.patch.yml",
      "home": "./dsh-home"
    },
    "exec": {
      "argv": ["/usr/local/bin/my-agent"],
      "input": "arg",
      "timeoutMs": 300000
    }
  }
}
