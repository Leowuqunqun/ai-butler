{
  "name": "wechat-agent-bridge",
  "version": "0.2.1",
  "description": "把微信变成你的 agent 遥控器 —— 个人微信扫码登录，长轮询收消息，交给可插拔的 agent 后端执行，支持回文本与文件",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wechat-agent-bridge": "src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.mjs"
    },
    "./plugin": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.mjs run",
    "qr": "node src/cli.mjs qr",
    "status": "node src/cli.mjs status",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test test/*.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@butler/seam-channel": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "wechat",
    "weixin",
    "ilink",
    "agent",
    "bot",
    "dsh",
    "claude-code",
    "remote-control"
  ]
}
