{
  "name": "@butler/channel-telegram",
  "version": "0.2.0",
  "description": "ctx.channel 的第二个实现：Telegram（长轮询，零第三方依赖）—— 同时是通道层抽象的一次验证",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./update": {
      "types": "./lib/types/update.d.ts",
      "default": "./lib/update.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@butler/seam-channel": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "keywords": [
    "cordis",
    "plugin",
    "channel",
    "telegram",
    "im"
  ]
}
