{
  "name": "@butler/cli",
  "version": "0.2.0",
  "description": "AI 管家的命令行入口：读配置、拉起 cordis 容器、上线",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "butler": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('node:fs').chmodSync('lib/cli.js',0o755)}catch{}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@butler/agent-dsh": "workspace:*",
    "@butler/agent-exec": "workspace:*",
    "@butler/channel-telegram": "workspace:*",
    "@butler/channel-feishu": "workspace:*",
    "@butler/core": "workspace:*",
    "@butler/link-lan": "workspace:*",
    "@butler/memory-file": "workspace:*",
    "@butler/approval-im": "workspace:*",
    "@butler/link-tailscale": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "wechat-agent-bridge": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@butler/seam-agent": "workspace:*",
    "@butler/seam-channel": "workspace:*"
  },
  "keywords": [
    "butler",
    "cli",
    "cordis"
  ]
}
