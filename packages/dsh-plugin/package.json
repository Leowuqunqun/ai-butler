{
  "name": "@butler/dsh-plugin",
  "version": "0.2.0",
  "description": "把微信接进 DSH：手机上说的话进 DSH 会话，DSH 的回复回到微信（一个 DSH bundle）",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./src/plugin.mjs"
    },
    "./bridge": {
      "default": "./src/bridge.mjs"
    },
    "./turn": {
      "default": "./src/turn.mjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "wechat-agent-bridge": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "scripts": {
    "test": "node --test test/*.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "wechat",
    "weixin",
    "butler"
  ]
}
