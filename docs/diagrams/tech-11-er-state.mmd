erDiagram
    OWNER ||--o{ SESSION : 拥有
    DEVICE ||--o{ SESSION : 承载
    SESSION ||--o{ APPROVAL : 产生
    SESSION ||--o{ AUDIT : 记录
    OWNER {
        string channel
        string userId
        datetime boundAt
    }
    DEVICE {
        string id
        string alias
        string os
        string linkType
        datetime lastSeen
    }
    SESSION {
        string channel
        string fromId
        string deviceId
        string agentSessionId
    }
    MEMORY {
        string key
        string type
        json value
    }
    APPROVAL {
        string id
        string action
        string decision
        datetime decidedAt
    }
    AUDIT {
        datetime ts
        string direction
        string summary
    }
