flowchart TB
    B["① 内置组合<br/>butler-base/cordis.patch.yml<br/>随包发布"]
    U["② 用户覆盖<br/>~/.butler/cordis.patch.yml<br/>引导页 / 对话里写它"]
    R["最终行集<br/>按 id 寻址 · 整行覆盖 · last write wins"]
    RT["cordis 运行时<br/>激活由「服务是否就绪」驱动，行序无语义"]
    S[("③ 运行期状态<br/>~/.butler/state/")]
    B -->|"一个 insert 施加在空根上"| R
    U -->|"覆盖默认行的整份 config"| R
    R --> RT
    S <-.->|"登录态 / 会话 / 记忆"| RT
    NOTE["架构对齐 dsh，但普通用户永远不该看到 ① ②"]
    NOTE -.-> B
    NOTE -.-> U
    classDef cfg fill:#D6E8FF,stroke:#3D7DE8,stroke-width:2px,color:#0B2E6B
    classDef rt fill:#EDE0FF,stroke:#8B5CF6,stroke-width:2px,color:#3B1D6E
    classDef store fill:#FFF6D6,stroke:#D9A400,stroke-width:2px,color:#5C4400
    classDef warn fill:#FFE0E0,stroke:#E5484D,stroke-width:2px,color:#6B0F14
    class B,U,R cfg
    class RT rt
    class S store
    class NOTE warn
